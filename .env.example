# Solami API key (get yours at https://solami.dev/signup?ref=st-earn-sep-26)
#
# Set BOTH lines to the same key:
#   VITE_SOLAMI_API_KEY  - read by the app when you run `npm run dev` locally
#   SOLAMI_API_KEY       - read by the serverless functions in /api (Vercel)
VITE_SOLAMI_API_KEY=your_api_key_here
SOLAMI_API_KEY=your_api_key_here

# Optional: only if your Data (Blur) key is different from the key above
# VITE_SOLAMI_DATA_KEY=your_data_key_here
# SOLAMI_DATA_KEY=your_data_key_here
